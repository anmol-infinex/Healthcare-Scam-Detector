{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt && npm install",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "excludeFiles": "{app,data,docs,notebooks,presentation,report,tests,public,scripts,node_modules,dist}/**",
      "includeFiles": "models/healthcare_scam_detector.joblib",
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*\\.(?:css|js|ico|png|jpg|jpeg|gif|svg|webp|json))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
